# Copy this file to .env and fill in your key before running.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Claude model used for the agent loop.
BOOKLY_MODEL=claude-sonnet-4-5-20250929

# Path to the SQLite database file. Deleted+reseeded automatically if missing.
BOOKLY_DB_PATH=bookly.db

# Optional shared passcode gating /chat and /trace. Leave unset for local dev
# (no gate). SET THIS as a secret on any public deploy -- otherwise anyone
# with the URL can burn your real Claude API quota.
BOOKLY_ACCESS_CODE=
