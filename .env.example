# Copy this file to .env and fill in your key before running.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Claude model used for the agent loop.
BOOKLY_MODEL=claude-sonnet-4-5-20250929

# Path to the SQLite database file. Deleted+reseeded automatically if missing.
BOOKLY_DB_PATH=bookly.db

# Optional shared passcode gating /chat and /trace. Leave unset for local dev
# (no gate). SET THIS as a secret on any public deploy -- otherwise anyone
# with the URL can burn your real Claude API quota.
BOOKLY_ACCESS_CODE=

# Optional: real observability via Langfuse (langfuse.com -- free Cloud tier
# or self-host). Leave both unset to skip; the app falls back to the local
# agent_traces table only.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional: ElevenLabs text-to-speech for spoken replies (elevenlabs.io).
# Leave unset to fall back to the browser's built-in speechSynthesis.
# Default voice_id below is "Rachel", a stock premade voice available on
# every account tier including free (the voice *library* isn't browsable via
# API on free tier, but premade voice IDs still work for synthesis).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# eleven_turbo_v2_5 is the sweet spot of natural-sounding vs latency for a
# support-chat reply; eleven_flash_v2_5 is faster but sounds more robotic,
# eleven_multilingual_v2 sounds best but is noticeably slower to generate.
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
